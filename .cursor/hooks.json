{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node scripts/harness/cli.mjs session",
        "timeout": 15
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node scripts/harness/cli.mjs guard",
        "timeout": 20,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "node scripts/harness/cli.mjs verify --profile fast",
        "timeout": 120
      }
    ]
  }
}
