{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "/bin/bash ./scripts/session-context.sh",
        "timeout": 15
      }
    ],
    "beforeShellExecution": [
      {
        "command": "/bin/bash ./scripts/cursor-before-shell.sh",
        "timeout": 20,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "/bin/bash ./scripts/verify.sh",
        "timeout": 120
      }
    ]
  }
}
