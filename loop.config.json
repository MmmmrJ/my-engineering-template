{
  "schemaVersion": 1,
  "patterns": [
    {
      "id": "harness-health",
      "enabled": true,
      "level": "L1",
      "mode": "report-only",
      "goal": "Detect harness drift, failed checks, and governance gaps without changing governed paths.",
      "nonGoals": ["Modify governed paths", "Approve tasks", "Push or merge changes"],
      "trigger": { "type": "manual", "fireImmediately": false, "offHours": "pause" },
      "scope": {
        "watchPaths": ["scripts/**", ".agents/**", ".codex/**", ".cursor/**", "docs/**"],
        "denyPaths": [".env", ".env.*", "**/secrets/**", "**/credentials/**", "apps/**", "packages/**"],
        "maxChangedFiles": 20
      },
      "roles": { "triageSkill": "loop-triage", "makerRole": null, "verifierRole": "qa_engineer", "independentVerifier": true },
      "state": { "summaryFile": "STATE.md", "runLogFile": "loop-run-log.md", "retentionDays": 90 },
      "budget": { "maxRunsPerDay": 4, "maxTokensPerRun": 50000, "maxTokensPerDay": 100000, "maxAttempts": 1, "maxActionsPerDay": 0, "on80Percent": "report-only", "onExceed": "pause" },
      "isolation": { "mode": "none", "lockPaths": [], "lockTtlSeconds": 0 },
      "gates": { "report": "allow", "proposal": "allow", "write": "approved-task", "push": "human", "merge": "never" },
      "checks": ["doctor-template-strict", "sync-agents", "guard-secrets", "loop-doctor-strict"],
      "escalation": { "sameErrorCount": 3, "noProgressCount": 3, "maxIterations": 5 }
    },
    {
      "id": "daily-triage",
      "enabled": true,
      "level": "L1",
      "mode": "report-only",
      "goal": "Produce a prioritized, low-noise report from repository health signals.",
      "nonGoals": ["Change code", "Close issues", "Approve or merge work"],
      "trigger": { "type": "manual", "fireImmediately": false, "offHours": "pause" },
      "scope": { "watchPaths": ["**"], "denyPaths": [".env", ".env.*", "**/secrets/**", "**/credentials/**"], "maxChangedFiles": 10 },
      "roles": { "triageSkill": "loop-triage", "makerRole": null, "verifierRole": "qa_engineer", "independentVerifier": true },
      "state": { "summaryFile": "STATE.md", "runLogFile": "loop-run-log.md", "retentionDays": 90 },
      "budget": { "maxRunsPerDay": 2, "maxTokensPerRun": 50000, "maxTokensPerDay": 100000, "maxAttempts": 1, "maxActionsPerDay": 0, "on80Percent": "report-only", "onExceed": "pause" },
      "isolation": { "mode": "none", "lockPaths": [], "lockTtlSeconds": 0 },
      "gates": { "report": "allow", "proposal": "allow", "write": "approved-task", "push": "human", "merge": "never" },
      "checks": ["loop-validate", "project-fast"],
      "escalation": { "sameErrorCount": 3, "noProgressCount": 3, "maxIterations": 5 }
    },
    {
      "id": "ci-sweeper",
      "enabled": false,
      "level": "L2",
      "mode": "assisted",
      "goal": "Diagnose failing CI and produce one minimal verified proposal in an isolated worktree.",
      "nonGoals": ["Approve its own task", "Push or merge automatically", "Change sensitive paths"],
      "trigger": { "type": "event", "fireImmediately": false, "offHours": "report-only" },
      "scope": { "watchPaths": ["apps/**", "packages/**", "scripts/**"], "denyPaths": [".env", ".env.*", "**/secrets/**", "**/credentials/**", "**/migrations/**", "auth/**", "payments/**", "billing/**"], "maxChangedFiles": 10 },
      "roles": { "triageSkill": "loop-triage", "makerRole": "backend_engineer", "verifierRole": "qa_engineer", "independentVerifier": true },
      "state": { "summaryFile": "STATE.md", "runLogFile": "loop-run-log.md", "retentionDays": 90 },
      "budget": { "maxRunsPerDay": 4, "maxTokensPerRun": 200000, "maxTokensPerDay": 500000, "maxAttempts": 3, "maxActionsPerDay": 1, "on80Percent": "report-only", "onExceed": "pause" },
      "isolation": { "mode": "worktree", "lockPaths": ["apps/**", "packages/**", "scripts/**"], "lockTtlSeconds": 21600 },
      "gates": { "report": "allow", "proposal": "allow", "write": "approved-task", "push": "human", "merge": "never" },
      "checks": ["project-full", "qa-acceptance"],
      "escalation": { "sameErrorCount": 3, "noProgressCount": 3, "maxIterations": 3 }
    }
  ]
}
