# Environment variable names used by optional provider adapters.
# This file documents names only. Load real values into the process environment
# or a secret manager; never commit populated credentials.

# MiniMax direct API (optional)
MINIMAX_API_KEY=

# Alibaba Wan through DashScope (optional)
DASHSCOPE_API_KEY=

# ComfyUI client identity for workflows that require one (optional; not a secret by default)
COMFYUI_CLIENT_ID=

