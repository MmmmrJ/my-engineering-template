{
  "name": "ai-cartoon-workflow",
  "version": "1.0.0",
  "private": true,
  "description": "A review-gated, provider-neutral AI cartoon drama production workflow.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <25"
  },
  "bin": {
    "cartoon": "./dist/cli/index.js"
  },
  "scripts": {
    "cartoon": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "tsx src/cli/index.ts doctor",
    "skills:sync": "node scripts/sync-skills.mjs --write",
    "skills:check": "node scripts/sync-skills.mjs --check",
    "validate:repository": "node scripts/validate-repository.mjs",
    "check": "npm run skills:check && npm run validate:repository && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@derhuerst/ffprobe-static": "5.3.0",
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
